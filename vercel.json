{
  "version": 2,
  "name": "dashboard-regional-chile",
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "dest": "/dashboard.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
